{
  "name": "gap-system-support",
  "displayName": "GAP System Support",
  "description": "GAP language support for VS Code with syntax highlighting, completion and run, powered by tree-sitter-gap",
  "version": "0.3.1",
  "publisher": "flianlee",
  "author": "Songtai Li",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lstflian/gap-system-support.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gap",
    "algebra",
    "group theory",
    "syntax highlighting",
    "tree-sitter",
    "completion",
    "run",
    "terminal",
    "math",
    "computer algebra",
    "gap help",
    "help system",
    "documentation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gap",
        "aliases": [
          "GAP",
          "gap"
        ],
        "extensions": [
          ".g",
          ".gi",
          ".gd",
          ".gap"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gap",
        "scopeName": "source.gap",
        "path": "./language/gap.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "escapeSequence",
        "superType": "string",
        "description": "Escape sequences inside GAP string and character literals"
      },
      {
        "id": "character",
        "superType": "string",
        "description": "GAP character literals"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gap",
        "scopes": {
          "keyword": [
            "keyword.control.gap"
          ],
          "string": [
            "string.quoted.gap"
          ],
          "number": [
            "constant.numeric.gap"
          ],
          "comment": [
            "comment.line.number-sign.gap"
          ],
          "operator": [
            "keyword.operator.gap"
          ],
          "variable.readonly": [
            "variable.other.constant.gap"
          ],
          "escapeSequence": [
            "constant.character.escape.gap"
          ],
          "character": [
            "constant.character.gap"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "gap.generateCompletionData",
        "title": "Generate Completion Data",
        "category": "GAP"
      },
      {
        "command": "gap.resetCompletionData",
        "title": "Reset Completion Data",
        "category": "GAP"
      },
      {
        "command": "gap.runFile",
        "title": "Run GAP File",
        "category": "GAP",
        "icon": "$(play)",
        "enablement": "resourceLangId == gap && resourceScheme != untitled"
      },
      {
        "command": "gap.configureFlags",
        "title": "Configure GAP Command Line Options",
        "category": "GAP"
      },
      {
        "command": "gap.searchHelp",
        "title": "Search GAP Help",
        "category": "GAP"
      },
      {
        "command": "gap.searchHelpTerm",
        "title": "Search GAP Help Term",
        "category": "GAP"
      },
      {
        "command": "gap.rebuildHelpIndex",
        "title": "Rebuild Help Index",
        "category": "GAP"
      },
      {
        "command": "gap.openReference",
        "title": "Open GAP Reference Manual",
        "category": "GAP"
      },
      {
        "command": "gap.openReadme",
        "title": "Open README",
        "category": "GAP"
      },
      {
        "command": "gap.openDocPathSetting",
        "title": "Open Doc Path Setting",
        "category": "GAP"
      },
      {
        "command": "gap.openPkgPathSetting",
        "title": "Open Pkg Path Setting",
        "category": "GAP"
      }
    ],
    "submenus": [
      {
        "id": "gap.contextMenu",
        "label": "More GAP Commands"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gap.openReadme",
          "when": "false"
        },
        {
          "command": "gap.openDocPathSetting",
          "when": "false"
        },
        {
          "command": "gap.openPkgPathSetting",
          "when": "false"
        },
        {
          "command": "gap.searchHelpTerm",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "gap.runFile",
          "when": "resourceLangId == gap && resourceScheme != untitled",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gap.searchHelp",
          "when": "resourceLangId == gap",
          "group": "navigation@1"
        },
        {
          "command": "gap.runFile",
          "when": "resourceLangId == gap",
          "group": "navigation@2"
        },
        {
          "submenu": "gap.contextMenu",
          "when": "resourceLangId == gap",
          "group": "navigation@3"
        }
      ],
      "gap.contextMenu": [
        {
          "command": "gap.configureFlags",
          "group": "1_run@1"
        },
        {
          "command": "gap.openReference",
          "group": "2_help@1"
        },
        {
          "command": "gap.rebuildHelpIndex",
          "group": "2_help@2"
        },
        {
          "command": "gap.generateCompletionData",
          "group": "3_data@1"
        },
        {
          "command": "gap.resetCompletionData",
          "group": "3_data@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "gap-support.gettingStarted",
        "title": "Start with GAP System Support",
        "description": "Syntax highlighting, code completion, running GAP code, and a help system for GAP. To get started, we need to make sure GAP is ready to use. Follow the steps below.",
        "steps": [
          {
            "id": "addGapToPath",
            "title": "Add GAP to the PATH",
            "description": "First, check that GAP is in your system PATH so the gap command works in the terminal. Skip this step if GAP is already configured. For configuration details, click the button below.\n[Open README](command:gap.openReadme)",
            "media": {
              "markdown": "media/gap-log.md"
            }
          },
          {
            "id": "setDocPath",
            "title": "Set the doc Path",
            "description": "Set this to the absolute path of the doc folder itself.\n[Open Doc Path Setting](command:gap.openDocPathSetting)",
            "media": {
              "markdown": "media/gap-log.md"
            },
            "completionEvents": [
              "onCommand:gap.openDocPathSetting"
            ]
          },
          {
            "id": "setPkgPath",
            "title": "Set the pkg Path",
            "description": "Set this to the absolute path of the pkg folder itself.\n[Open Pkg Path Setting](command:gap.openPkgPathSetting)",
            "media": {
              "markdown": "media/gap-log.md"
            },
            "completionEvents": [
              "onCommand:gap.openPkgPathSetting"
            ]
          },
          {
            "id": "searchHelp",
            "title": "Search the Help and Browse Manuals",
            "description": "Click the button below, then enter a term to search GAP help.\n[Search GAP Help](command:gap.searchHelp)",
            "when": "config.gap.docPath != '' && config.gap.pkgPath != ''",
            "media": {
              "markdown": "media/gap-log.md"
            },
            "completionEvents": [
              "onCommand:gap.searchHelp"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "GAP System Support",
      "properties": {
        "gap.docPath": {
          "type": "string",
          "default": "",
          "order": 1,
          "markdownDescription": "Path to the `doc/` directory, e.g. `C:\\Program Files\\GAP-4.16.0\\runtime\\opt\\gap-4.16.0\\doc` or `/opt/gap-4.16.0/doc`."
        },
        "gap.pkgPath": {
          "type": "string",
          "default": "",
          "order": 2,
          "markdownDescription": "Path to the `pkg/` directory, e.g. `C:\\Program Files\\GAP-4.16.0\\runtime\\opt\\gap-4.16.0\\pkg` or `/opt/gap-4.16.0/pkg`."
        },
        "gap.runMode": {
          "type": "string",
          "order": 5,
          "enum": [
            "reuse",
            "new"
          ],
          "default": "reuse",
          "enumDescriptions": [
            "Reuse the same GAP terminal.",
            "Open a new terminal for each run."
          ],
          "description": "Terminal behavior when running a GAP file."
        },
        "gap.terminalRoot": {
          "type": "string",
          "default": "",
          "order": 6,
          "markdownDescription": "Unix root for Windows drive letters. Example: `/` turns `C:\\project\\file.g` into `/c/project/file.g`. Leave empty to use WSL default `/mnt/`.",
          "scope": "application"
        },
        "gap.docAppearance": {
          "type": "string",
          "order": 3,
          "enum": [
            "system",
            "dark",
            "light"
          ],
          "default": "system",
          "description": "Appearance of GAP documentation pages: 'system' follows the VS Code theme, 'dark'/'light' force a mode for all manuals."
        },
        "gap.mathJax": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Render math in GAP documentation pages with MathJax."
        },
        "gap.searchMode": {
          "type": "string",
          "order": 7,
          "enum": [
            "prefix",
            "substring"
          ],
          "default": "prefix",
          "description": "Search mode: prefix (?topic) matches from the start of a word, substring (??topic) matches anywhere"
        },
        "gap.diagnostics": {
          "type": "boolean",
          "default": true,
          "order": 8,
          "description": "Show syntax error diagnostics (missing/expected tokens, unexpected syntax) from the GAP parser in the Problems panel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "query": "node test/lib/highlight/query.js",
    "generate:highlight-queries": "node scripts/query-generator/generate-highlight-queries.js",
    "test": "node test/run-all.js"
  },
  "dependencies": {
    "web-tree-sitter": "^0.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.125.0",
    "typescript": "^5.4.0"
  }
}
